# 让 Git 自动识别文本文件
* text=auto

# 这些文件统一用 LF，避免反复提示「LF 会被替换成 CRLF」
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# 二进制文件不要动
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary